# AutoShorts Engine — Environment Variables
# Copy this file to .env and fill in your API keys.
# Never commit the real .env to version control.

# ─────────────────────────────────────────────────────────
# REQUIRED API KEYS
# ─────────────────────────────────────────────────────────

# Google Gemini (AI script + topic generation)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels (copyright-safe stock videos — primary source)
# Get at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 (for trend discovery)
# Get at: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ─────────────────────────────────────────────────────────
# OPTIONAL API KEYS
# ─────────────────────────────────────────────────────────

# Pixabay (fallback video source)
# Get at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# NewsAPI (additional news headlines for trend discovery)
# Get at: https://newsapi.org/
NEWS_API_KEY=

# ─────────────────────────────────────────────────────────
# CONTENT SETTINGS
# ─────────────────────────────────────────────────────────

# Describe your channel's theme (Gemini uses this to generate relevant topics)
CHANNEL_NICHE=Interesting facts and viral stories

# Primary region for YouTube trending (ISO 3166-1 alpha-2)
REGION_CODE=US

# Voice language for narration
DEFAULT_LANGUAGE=English

# Default voice gender: male | female
DEFAULT_GENDER=female

# YouTube upload privacy: private | unlisted | public
DEFAULT_PRIVACY=private

# ─────────────────────────────────────────────────────────
# SCHEDULER
# ─────────────────────────────────────────────────────────

# How many videos to produce per daily run
DAILY_VIDEO_COUNT=2

# Upload times (24-hour HH:MM local time)
UPLOAD_TIME_1=10:00
UPLOAD_TIME_2=18:00

# ─────────────────────────────────────────────────────────
# TREND DISCOVERY
# ─────────────────────────────────────────────────────────

# Comma-separated list of regions for YouTube trend fetching
TREND_REGIONS=US,GB,CA,AU,IN,PK,DE,FR,BR,JP

# YouTube videos fetched per region
TREND_VIDEOS_PER_REGION=10

# ─────────────────────────────────────────────────────────
# AI MODEL
# ─────────────────────────────────────────────────────────

# Gemini model name (pipeline tries this first, then falls back)
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────
# VOICE SETTINGS (Edge-TTS voice IDs)
# ─────────────────────────────────────────────────────────

VOICE_ENGLISH_FEMALE=en-US-AriaNeural
VOICE_ENGLISH_MALE=en-US-GuyNeural
VOICE_URDU_FEMALE=ur-PK-UzmaNeural
VOICE_URDU_MALE=ur-PK-AsadNeural

# ─────────────────────────────────────────────────────────
# VIDEO RENDERER
# ─────────────────────────────────────────────────────────

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Font for subtitles and thumbnails (Windows path shown — update for Linux/Mac)
FONT_PATH=C:\Windows\Fonts\arialbd.ttf

# ─────────────────────────────────────────────────────────
# RESILIENCE
# ─────────────────────────────────────────────────────────

# Max retry attempts per pipeline step
MAX_PIPELINE_RETRIES=3

# HTTP request timeout (seconds)
API_TIMEOUT_SECONDS=45